<file path="Frontend/src/app/pages/dashboard-dipendente/dashboard-dipendente.page.html">
<ion-header class="ion-no-border">
  <ion-toolbar color="dark"> 
    <ion-buttons slot="start">
      <ion-button routerLink="/home">
        <ion-icon slot="icon-only" name="arrow-back-outline"></ion-icon>
      </ion-button>
    </ion-buttons>
    <ion-title>Home</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content>
  <section class="dashboard-header">
    <h1>Area Operativa</h1>
    <p>Monitora le tue assegnazioni, il calendario e lo storico degli interventi completati.</p>
  </section>

  <ion-grid>
    <ion-row class="summary-row">
      <ion-col size="6">
        <div class="summary-card">
          <span class="summary-value">{{ interventiAttivi.length }}</span>
          <span class="summary-label">Interventi assegnati</span>
        </div>
      </ion-col>
      <ion-col size="6">
        <div class="summary-card">
          <span class="summary-value">{{ storicoInterventi.length }}</span>
          <span class="summary-label">Storico Completati</span>
        </div>
      </ion-col>
    </ion-row>

    <ion-row class="details-row">
      <ion-col size="12" size-md="6">
        <ion-card class="detail-section-card">
          <ion-card-header>
            <ion-card-title>Interventi Attivi</ion-card-title>
          </ion-card-header>
          <ion-card-content class="scrollable-list">
            @for (intervento of interventiAttivi; track intervento.id) {
              <div class="dashboard-item clickable" [routerLink]="['/dettaglio-intervento-dipendente', intervento.id]">
                <div class="item-header">
                  <h3>{{ intervento.cliente_nome }} {{ intervento.cliente_cognome }}</h3>
                  <ion-chip>{{ intervento.stato_lavorazione }}</ion-chip>
                </div>
                <p style="margin-bottom: 4px;">
                  Luogo: {{ intervento.luogo }} | Data: {{ intervento.data_accettata}}
                </p>
                <p>
                  Descrizione: {{ intervento.descrizione }}
                </p>
              </div>
            } @empty {
              <div class="empty-section">Nessun intervento assegnato.</div>
            }
          </ion-card-content>
        </ion-card>
      </ion-col>

      <ion-col size="12" size-md="6">
        <ion-card class="detail-section-card">
          <ion-card-header>
            <ion-card-title>Storico Interventi</ion-card-title>
          </ion-card-header>
          <ion-card-content class="scrollable-list">
            @for (storico of storicoInterventi; track storico.id) {
              <div class="dashboard-item">
                <div class="item-header">
                  <h3>{{ storico.cliente_nome }} {{ storico.cliente_cognome }}</h3>
                  <ion-chip class="status-completed">{{ storico.stato }}</ion-chip>
                </div>
                <p style="margin-bottom: 4px;">Lavoro: {{ storico.descrizione }}</p>
                <p>Completato in data: {{ storico.dataCompletamento }}</p>
              </div>
            } @empty {
              <div class="empty-section">Nessun intervento nello storico.</div>
            }
          </ion-card-content>
        </ion-card>
      </ion-col>

    </ion-row>
  </ion-grid>
</ion-content>
</file>


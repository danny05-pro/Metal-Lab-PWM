      color: #b7c0cc !important;
      font-weight: 500 !important;
    }

    /* Cerchietto di selezione */
    .alert-radio-icon {
      border-color: #6c7a89 !important; /* Cerchio grigio inattivo */
    }
    
    .alert-radio-inner {
      background-color: #f5a623 !important; /* Pallino interno ambra */
    }

    /* Stato selezionato (Checked) */

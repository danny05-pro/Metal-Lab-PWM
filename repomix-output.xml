const db = require('../database/database');

exports.create = (dati) => {
  return new Promise((resolve, reject) => {
    db.run(
      `
        INSERT INTO interventi
        (cliente_id, descrizione, luogo, priorita, data_richiesta, data_proposta_cliente)
        VALUES (?, ?, ?, ?, ?, ?)
      `,
      [
        dati.cliente_id,
        dati.descrizione,
        dati.luogo,
        dati.priorita,
        dati.data_richiesta,
        dati.data_proposta_cliente
      ],
      function (err) {
        if (err) {
          reject(err);
        } else {
          resolve({
            id: this.lastID,
            ...dati
          });
        }
      }
    );
  });
};


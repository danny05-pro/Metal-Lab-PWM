                </div>

              </div>
              <p>Cliente: {{ preventivo.cliente_nome }} {{ preventivo.cliente_cognome }} | Preventivo #{{ preventivo.id }}</p>
            </div>
           } @empty {
             <div class="empty-section">Nessun preventivo da gestire.</div>
           }

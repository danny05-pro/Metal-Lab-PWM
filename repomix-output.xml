      .alert-radio-label {
        color: #ffffff !important;
        font-weight: 700 !important;
      }
      .alert-radio-icon {
        border-color: #f5a623 !important; /* Bordo cerchio ambra */
      }
    }
  }

/* Bottoni - Colori Infallibili */
  .alert-button-group {
    
    /* Tasto ANNULLA (usiamo sia la nostra classe che il ruolo di Ionic per sicurezza) */
    .alert-button.dark-alert-btn-cancel,
    .alert-button.alert-button-role-cancel {
      color: #b7c0cc !important;
      
      /* Forza il colore anche sullo span di testo interno */

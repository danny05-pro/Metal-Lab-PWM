    overflow: hidden;
    transition: all 0.2s ease;
  }

  &:hover::part(native) {
    background: #f5a623;
    border-color: #f5a623;
    color: #0b0f14;
  }
}

.apple-btn-header.btn-logout:hover::part(native) {
  background: #eb445a;
  border-color: #eb445a;
  color: #ffffff;
}

.hero {
  min-height: 92vh;
  background:
    linear-gradient(110deg, rgba(5, 8, 12, 0.95) 0%, rgba(5, 8, 12, 0.85) 45%, rgba(5, 8, 12, 0.4) 100%),
    url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=1800&auto=format&fit=crop');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  padding: 40px 5%;
}

.hero-container {
  max-width: 1300px; 
  width: 100%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px; 
}

/* Colonna Sinistra: Testo e Tasto */
.hero-content {
  flex: 1;
  max-width: 600px;
  color: white;
}

.eyebrow {
  color: #f5a623;
  text-transform: uppercase;
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 20px;
}

.hero-content h1 {
  font-size: clamp(2.5rem, 4vw, 3.8rem); 
  line-height: 1.1;
  font-weight: 900;
  margin: 0;
}

.subtitle {
  color: #d7dde5;
  font-size: 1.05rem;
  line-height: 1.6;
  margin-top: 24px;
  max-width: 500px;
}

/* Tasto Hero - Stile Vetro Apple */
.hero-actions {
  margin-top: 32px;
  display: flex;        
  flex-direction: row;  
  gap: 16px;
}

.hero-actions ion-button {
  width: 240px; 
  margin: 0;
  height: 52px;
  font-weight: 600;
  letter-spacing: -0.2px;

  --background: rgba(255, 255, 255, 0.06);
  --color: #ffffff;
  --border-radius: 16px;
  --border-width: 1px;
  --border-style: solid;
  --border-color: rgba(255, 255, 255, 0.15);
  --box-shadow: none;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px;
  overflow: hidden;
  transform: translateZ(0); 
  transition: all 0.2s ease;

  &:hover {
    --background: #f5a623;
    --border-color: #f5a623;
    --color: #0b0f14;
    transform: translateY(-2px) translateZ(0);
  }
}

/* Colonna Destra: Glassmorphism Cards */
.hero-services {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 550px; 
}

.service-glass-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: 4px solid #f5a623;
  border-radius: 16px;
  padding: 24px 30px;
  display: flex;
  align-items: flex-start;
  gap: 20px;
  transition: all 0.3s ease;
  
  &:hover {
    transform: translateX(-6px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(245, 166, 35, 0.3);
  }

  ion-icon {
    font-size: 32px;
    color: #f5a623;
    flex-shrink: 0;
  }
}

.glass-info h3 {
  margin: 0 0 8px;
  color: white;
  font-size: 1.1rem;
  font-weight: 800;
}

.glass-info p {
  margin: 0;
  color: #b7c0cc;
  font-size: 0.9rem;
  line-height: 1.5;
}

/* --- SEZIONE COMPETENZE RESA TRASPARENTE --- */
.features {
  background: transparent; 
  color: white;
  padding: 80px 5%;
}

.section-title {
  max-width: 800px;
  margin: 0 auto 40px;
  text-align: center;
}

.section-title p {
  color: #f5a623;
  text-transform: uppercase;
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.section-title h2 {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 850;
  margin: 12px 0 0;
}

.cards-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

/* --- APPLICA QUESTA MODIFICA --- */
.feature-card {
  background: linear-gradient(180deg, #171d25, #10151c);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 20px;
  padding: 30px 24px;
  min-height: 220px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  
  /* 1. AGGIUNGIAMO LA TRANSIZIONE (coerente 0.2s) */
  transition: transform 0.2s ease, border-color 0.2s ease;
  
  /* 2. AGGIUNGIAMO L'EFFETTO HOVER */
  &:hover {
    /* NUOVO EFFETTO COERENTE CON LA SEZIONE SOTTO: spostamento verso l'alto */
    transform: translateY(-4px); 
    
    /* E il bagliore arancione del bordo coerente con l'altra sezione */
    border-color: rgba(245, 166, 35, 0.3);
  }
}

.feature-card ion-icon {
  font-size: 40px;
  color: #f5a623;
  margin-bottom: 20px;
}

.feature-card h3 {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 12px;
}

.feature-card p {
  color: #b7c0cc;
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
}

@media (max-width: 1024px) {
  .hero-container {
    flex-direction: column;
    justify-content: center;
    gap: 40px;
  }

  .hero-content, .hero-services {
    max-width: 100%;
    flex: none;
  }

  .service-glass-card:hover {
    transform: none;
  }

  .cards-grid {
    grid-template-columns: 1fr;
    max-width: 600px;
  }
}

/* --- SEZIONE STAFF ADVANTAGE RESA TRASPARENTE --- */
.staff-advantage {

    .alert-button:not(.alert-button-role-cancel):not(.dark-alert-btn-danger) {
      color: #f5a623 !important;
      
      .alert-button-inner {
        color: #f5a623 !important;
        font-weight: 800 !important;
      }
    }
  }

}


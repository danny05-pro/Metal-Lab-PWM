  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: transform 0.2s ease;

  &:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 166, 35, 0.3);
  }

  ion-icon {
    font-size: 44px;
    color: #f5a623; 
    margin-bottom: 16px;
  }

  h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }

  p {
    color: #b7c0cc;
    line-height: 1.6;
    font-size: 0.95rem;
  }
}

/* Ottimizzazione per smartphone */
@media (max-width: 768px) {

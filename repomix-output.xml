<file path="Frontend/src/app/pages/catalogo/catalogo.page.html">
<ion-header class="ion-no-border">
  <ion-toolbar color="dark"> 
    
    <ion-buttons slot="start">
      <ion-button routerLink="/home">
        <ion-icon slot="icon-only" name="arrow-back-outline"></ion-icon>
      </ion-button>
    </ion-buttons>

    <ion-title>
      Home
    </ion-title>

  </ion-toolbar>
</ion-header>

<ion-content>

  <section class="catalog-header">
    <h1>Catalogo Metal Lab</h1>
    <p>
      Esplora prodotti e servizi dell’officina e salva quelli di tuo interesse.
    </p>
  </section>

  <ion-segment
    [value]="selectedSection"
    (ionChange)="cambiaSezione($event)"
    class="catalog-segment">

    <ion-segment-button value="prodotti">
      <ion-label>Prodotti</ion-label>
    </ion-segment-button>

    <ion-segment-button value="servizi">
      <ion-label>Servizi</ion-label>
    </ion-segment-button>

    <ion-segment-button value="preferiti">
      <ion-label>Preferiti</ion-label>
    </ion-segment-button>

  </ion-segment>

  <section class="catalog-grid">


     @if (selectedSection === 'prodotti') {

  @for (prodotto of prodotti; track prodotto.id) {

    <app-product-card
      [prodotto]="prodotto"
      [onTogglePreferito]="toggleProdottoPreferito.bind(this)">
    </app-product-card>

  }

}


   @if (selectedSection === 'servizi') {

  @for (servizio of servizi; track servizio.id) {

    <app-service-card
      [servizio]="servizio"
      [onTogglePreferito]="toggleServizioPreferito.bind(this)">
    </app-service-card>

  }

}
@if (selectedSection === 'preferiti') {

  @if (prodottiPreferiti.length === 0 && serviziPreferiti.length === 0) {

    <div class="empty-state">
      <h2>Nessun preferito</h2>
      <p>
        Aggiungi prodotti o servizi ai preferiti per ritrovarli qui.
      </p>
    </div>

  }

  @for (prodotto of prodottiPreferiti; track prodotto.id) {

    <app-product-card
      [prodotto]="prodotto"
      [onTogglePreferito]="toggleProdottoPreferito.bind(this)">
    </app-product-card>

  }

  @for (servizio of serviziPreferiti; track servizio.id) {

    <app-service-card
      [servizio]="servizio"
      [onTogglePreferito]="toggleServizioPreferito.bind(this)">
    </app-service-card>

  }

}
</file>


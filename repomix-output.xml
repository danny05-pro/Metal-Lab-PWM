  }
}

.custom-dark-alert {
  --backdrop-opacity: 0.7;

  /* Riquadro principale dell'Alert: FORZIAMO LO SFONDO SCURO QUI */
  .alert-wrapper {
    background: #151b23 !important; /* <--- QUESTA È LA RIGA CHE CAMBIA TUTTO */
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 24px !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8) !important;
  }

  /* Titolo */
  .alert-title {
    color: #ffffff !important;
    font-weight: 800 !important;
    font-size: 1.25rem !important;
    margin-top: 8px !important;
    text-align: center !important;
    width: 100% !important;
  }

  /* Testo descrittivo */
  .alert-message {
    color: #b7c0cc !important;
    font-size: 0.95rem !important;
  }
/* Stile personalizzato per la casella di input */
  .alert-input {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: #ffffff !important;
    border-radius: 12px !important;
    margin-top: 14px !important;
    padding: 14px !important;
    transition: border-color 0.2s ease !important;

    /* KILLER DELLE FRECCETTE per Chrome, Safari, Edge, Opera */
    &::-webkit-outer-spin-button,
    &::-webkit-inner-spin-button {
      -webkit-appearance: none !important;
      margin: 0 !important;
    }

    /* KILLER DELLE FRECCETTE per Firefox */
    &[type=number] {
  appearance: textfield !important;
  -moz-appearance: textfield !important;
}//-moz-appearance vale per Firefox,appearance è la proprietà standard riconosciuta dagli altri browser
    /* Quando ci clicchi sopra, il bordo diventa ambra */
    &:focus {
      border-color: #f5a623 !important;
      box-shadow: none !important; 
    }
  }

  .alert-radio-group {
    border: none !important; /* <--- Rimozione delle linee bianche! */
  }

  .alert-radio-button {
    /* Testo delle opzioni (Bassa, Media, Alta) */

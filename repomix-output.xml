        </ion-card>
      </ion-col>

      <ion-col size="12" size-md="6">
        <ion-card class="detail-section-card">
          <ion-card-header class="card-header-flex">
            <ion-card-title>Gestione Interventi</ion-card-title>
          </ion-card-header>
          <ion-card-content class="scrollable-list">
            @for (intervento of interventi; track intervento.id) {
              <div class="dashboard-item clickable" [routerLink]="['/dettaglio-intervento-admin', intervento.id]">
                <div class="item-header">
                  <h3>{{ intervento.descrizione }}</h3>
              <ion-chip [color]="getStatoInterventoUX(intervento).color" style="margin: 0; font-size: 0.75rem;">
                <ion-icon [name]="getStatoInterventoUX(intervento).icon"></ion-icon>
                <ion-label>{{ getStatoInterventoUX(intervento).label }}</ion-label>
              </ion-chip>

                </div>
                <p>Cliente: {{ intervento.cliente_nome }} {{ intervento.cliente_cognome }} | Priorità: {{ intervento.priorita }}</p>
                <p>Luogo: {{ intervento.luogo }}</p>
              </div>
            } @empty {
              <div class="empty-section">Nessun intervento da gestire.</div>
            }
          </ion-card-content>
        </ion-card>
      </ion-col>

      <ion-col size="12">
        <ion-card class="detail-section-card">
          <ion-card-header class="card-header-flex">
            <ion-card-title>Gestione Catalogo</ion-card-title>
            <ion-button fill="clear" color="warning" size="small" (click)="aggiungiVoceCatalogo()">
              <ion-icon slot="start" name="add-outline"></ion-icon>
              Nuovo
            </ion-button>
          </ion-card-header>
          <ion-card-content class="scrollable-list">
            @for (voce of catalogo; track voce.id) {
              <div class="dashboard-item catalog-list-item">
                
                <div class="catalog-thumbnail">
                  <img [src]="getImmagineUrl(voce.immagine)" alt="Anteprima">
                </div>

                <div class="catalog-info">
                  <div class="item-header">
                    <h3>{{ voce.nome }}</h3>
                    <ion-chip color="medium">{{ voce.categoria }}</ion-chip>
                  </div>
                  
                  <p class="catalog-price">Prezzo Base: {{ voce.prezzoBase }}</p>
                  
                  <div class="item-actions">
                    <ion-button fill="clear" color="light" size="small" (click)="modificaVoceCatalogo(voce.id)">
                      <ion-icon slot="start" name="create-outline"></ion-icon> Modifica
                    </ion-button>
                    <ion-button fill="clear" color="danger" size="small" (click)="eliminaVoceCatalogo(voce.id)">
                      <ion-icon slot="start" name="trash-outline"></ion-icon> Elimina
                    </ion-button>
                  </div>
                </div>

              </div>
            } @empty {
              <div class="empty-section">Il catalogo è vuoto.</div>
            }
          </ion-card-content>
        </ion-card>
      </ion-col>

    </ion-row>
  </ion-grid>

<ion-modal [isOpen]="isModalOpen" (didDismiss)="chiudiModale()" class="dark-modal">
    <ng-template>
      <ion-header class="ion-no-border">
        <ion-toolbar color="dark">
          <ion-title>{{ modalMode === 'crea' ? 'Nuova Voce' : 'Modifica Voce' }}</ion-title>
          <ion-buttons slot="end">
            <ion-button (click)="chiudiModale()">
              <ion-icon slot="icon-only" name="close-outline"></ion-icon>
            </ion-button>
          </ion-buttons>
        </ion-toolbar>
      </ion-header>

      <ion-content class="ion-padding" style="--background: #151b23;">
        
@if (formCatalogo.immagine) {
  <div style="text-align: center; margin-bottom: 20px;">
    <img 
      [src]="(formCatalogo.immagine.startsWith('blob:') || formCatalogo.immagine.startsWith('http')) 
             ? formCatalogo.immagine 
             : 'http://localhost:3000' + formCatalogo.immagine" 
      alt="Anteprima" 
      style="width: 100%; height: 180px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
  </div>
}

        <ion-item color="dark" class="custom-input-item">
          <ion-input label="Nome Voce" labelPlacement="stacked" type="text" [(ngModel)]="formCatalogo.nome" placeholder="Es: Taglio Laser"></ion-input>
        </ion-item>

        <ion-item color="dark" class="custom-input-item" style="margin-top: 15px;">
          <ion-select 
            label="Categoria" 
            labelPlacement="stacked" 
            [(ngModel)]="formCatalogo.categoria" 
            interface="popover" 
            [interfaceOptions]="{ cssClass: 'status-popover-theme' }">
            

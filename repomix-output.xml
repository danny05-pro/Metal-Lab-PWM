ion-content {
  --background: #0b0f14;
}

.dashboard-header {
  padding: 32px 22px 16px;
  text-align: center;
  color: white;
}

.dashboard-header h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 900;
  margin: 0;
}

.dashboard-header p {
  color: #b7c0cc;
  margin-top: 8px;
}

// Riga contatori orizzontali
.summary-row {
  max-width: 1400px;
  margin: 0 auto 24px;
  text-align: center;
}

.summary-card {
  background: #151b23;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.summary-value {
  font-size: 1.8rem;
  font-weight: 800;
  color: #f5a623;
}

.summary-label {
  font-size: 0.8rem;
  color: #b7c0cc;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-top: 4px;
}

// Struttura layout verticale per i dettagli
.details-row {
  max-width: 1400px;
  margin: 0 auto;
}

.detail-section-card {
  --background: #151b23;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 10px;
  height: auto;
  min-height: 120px;
}

ion-card-title {
  color: white;
  font-size: 1.2rem;
  font-weight: 800;
}

/* Stili per le liste Interventi e Storico */
.dashboard-item {
  /* Aggiunto padding orizzontale per far respirare l'alone dell'hover */
  padding: 16px; 
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  
  /* Arrotonda l'alone di selezione dell'intera riga al passaggio del mouse! */
  border-radius: 18px; 
  margin-bottom: 4px;
}

.dashboard-item:last-child {
  border-bottom: none;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.dashboard-item h3 {
  color: white;
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
}

.dashboard-item p {
  color: #b7c0cc;
  margin: 0;
  font-size: 0.9rem;
}

ion-chip {
  margin: 0;
  background: rgba(245, 166, 35, 0.12);
  color: #f5a623;
  font-weight: 700;
  font-size: 0.8rem;
  
  /* MAGIA APPLE: Forza la forma a "pillola" perfettamente arrotondata */
  --border-radius: 30px;
  border-radius: 30px;
  padding: 0 12px;
  
  &.status-completed {
    background: rgba(45, 211, 111, 0.12);
    color: #2dd36f;
  }
}

.empty-section {
  color: #6c7a89;
  font-style: italic;
  padding: 10px 0;
  font-size: 0.95rem;
}


/* Contenitore principale (definisce la misura del bottone) */
.status-wrapper {
  position: relative;
  width: 135px;
  min-width: 135px;
  height: 32px;
  margin: 0;
  cursor: pointer;
}

/* La nostra grafica personalizzata, slegata dalle regole noiose di Ionic */
.status-badge {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  
  background: rgba(245, 166, 35, 0.12);
  color: #f5a623;
  border-radius: 12px;
  font-size: 0.85rem;
  font-weight: 700;
  
  /* Centratura Flexbox PURA: infallibile */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* Ignora il mouse per far sì che il click passi al select sottostante */
  pointer-events: none; 
  transition: background 0.2s ease;
  
  ion-icon {
    font-size: 13px;
    margin-left: 6px;
  }
}

/* Effetto hover */
.status-wrapper:hover .status-badge {
  background: rgba(245, 166, 35, 0.2);
}

/* Il selettore originale Ionic: si sovrappone a tutto ma è trasparente */
.hidden-select {
  position: absolute;
  top: 0; left: 0; 
  width: 100%; height: 100%;
  
  opacity: 0; /* LA MAGIA È QUI: Lo rende un fantasma! */
  
  margin: 0;
  padding: 0;
  cursor: pointer;
  z-index: 2; /* Sta sopra al badge visibile */
}
.clickable {
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.clickable:hover {
  background: rgba(255, 255, 255, 0.04);
  transform: translateY(-1px);
}

.open-detail-text {
  margin-top: 8px !important;
  color: #f5a623 !important;
  font-weight: 700;
  font-size: 0.85rem !important;
}

/* --- Stile per le liste con altezza fissa e scrollbar --- */
.scrollable-list {
  max-height: 340px; /* L'altezza massima prima di far comparire la rotellina */
  overflow-y: auto;
  padding-right: 6px; /* Spazio per non far accavallare il testo alla barra */

  /* Scrollbar stile Metal Lab */
  &::-webkit-scrollbar {
    width: 6px;
  }
  
  &::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
  }
  
  &::-webkit-scrollbar-thumb {
    background: rgba(245, 166, 35, 0.2); /* Ambra leggero */
    border-radius: 10px;
    transition: background 0.3s ease;
  }
  
  &::-webkit-scrollbar-thumb:hover {
    background: rgba(245, 166, 35, 0.6); /* Ambra più acceso al passaggio del mouse */
  }
}
</file>


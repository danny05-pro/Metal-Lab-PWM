/* ==========================================================================
   Modale Calendario Pop-up - Tema Scuro/Ambra (Wheel Picker Disabilitato)
   ========================================================================== */

ion-modal.dark-calendar-modal {
  --width: max-content;
  --height: max-content;
  --background: transparent;
  --box-shadow: none;
  --border-radius: 24px; 
  
  align-items: center;
  justify-content: center;

  ion-datetime.custom-amber-calendar {
    /* Background e Struttura Generale */
    --background: #151b23;
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
    
    /* Colore del testo standard (Giorni della griglia) */
    color: #ffffff; 
    --ion-text-color: #ffffff;
    --ion-text-color-rgb: 255, 255, 255;

    /* Variabili Tema Ambra (Giorno attivo e bottoni base) */
    --ion-color-primary: #f5a623;
    --ion-color-primary-rgb: 245, 166, 35;
    --ion-color-primary-contrast: #0b0f14;
    --ion-color-primary-contrast-rgb: 11, 15, 20;

    
    /* 1. Mese e Anno: Colore Ambra e DISABILITAZIONE CLICK */
    /* ==========================================================
       HEADER E INIBIZIONE DEL WHEEL PICKER
       ========================================================== */
    
    /* 1. Mese e Anno: Rimozione freccetta, Colore Ambra e DISABILITAZIONE CLICK */
    &::part(month-year-button) {
      pointer-events: none; /* Impedisce l'apertura della rotella */

      /* TRUCCO CSS: Nasconde l'icona SVG mantenendo il testo perfetto */
      color: transparent; 
      text-shadow: 0 0 0 #f5a623; 
    }

    /* 2. Frecce Direzionali: Colore Ambra e interattività mantenuta */
    &::part(prev-month-button),
    &::part(next-month-button) {
      color: #f5a623;
      opacity: 1 !important;
    }

    /* 3. Soppressione dell'alone di background sugli stati di interazione delle frecce */
    &::part(prev-month-button):hover,
    &::part(next-month-button):hover,
    &::part(prev-month-button):active,
    &::part(next-month-button):active {
      background: #151b23 !important;
      background-color: #151b23 !important;
      opacity: 1 !important; 
    }
  }
}

          <span class="summary-value">{{ totalePreventivi }}</span>
          <span class="summary-label">Preventivi Da Gestire</span>
        </div>
      </ion-col>

      <ion-col size="12" size-md="4">
        <div class="summary-card">
          <span class="summary-value">{{ interventiAperti }}</span>
          <span class="summary-label">Interventi Aperti</span>
        </div>
      </ion-col>
      <ion-col size="12" size-md="4">
        <div class="summary-card">
          <span class="summary-value">{{ vociCatalogo }}</span>
          <span class="summary-label">Voci in Catalogo</span>
        </div>
      </ion-col>
    </ion-row>

    <ion-row class="details-row">
      
      <ion-col size="12" size-md="6">
        <ion-card class="detail-section-card">
          <ion-card-header class="card-header-flex">
            <ion-card-title>Gestione Preventivi</ion-card-title>
          </ion-card-header>
          <ion-card-content class="scrollable-list">
           @for (preventivo of preventivi; track preventivo.id) {

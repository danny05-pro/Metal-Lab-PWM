}

.actions {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.btn-glass-assign {
  margin: 0;
  height: 52px;
  font-weight: 600;
  letter-spacing: -0.2px;

  --border-radius: 16px;
  --border-width: 1px;
  --border-style: solid;
  --box-shadow: none;

  /* Effetto vetro sfocato */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px;
  overflow: hidden;
  transform: translateZ(0);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

  /* Colori Ambra Translucidi */
  --background: rgba(245, 166, 35, 0.12);
  --color: #f5a623;
  --border-color: rgba(245, 166, 35, 0.2);

  &:hover {
    --background: #f5a623;
    --border-color: #f5a623;
    --color: #0b0f14;
    transform: translateY(-2px);
  }
}
.btn-glass-reject {
  margin: 0;
  height: 52px;
  font-weight: 600;
  letter-spacing: -0.2px;

  --border-radius: 16px;
  --border-width: 1px;
  --border-style: solid;
  --box-shadow: none;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px;
  overflow: hidden;
  transform: translateZ(0);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

  --background: rgba(235, 68, 90, 0.12);
  --color: #eb445a;
  --border-color: rgba(235, 68, 90, 0.2);

  &:hover {
    --background: #eb445a;
    --border-color: #eb445a;
    --color: #ffffff;
    transform: translateY(-2px);
  }
}
.calendar-trigger-item {
  --background: transparent;
  --color: white;
  --border-color: rgba(255, 255, 255, 0.12);
  margin-bottom: 16px;
}

.calendar-trigger-item ion-label {
  color: #f5a623 !important;
  font-weight: 700;
}

.calendar-trigger-item ion-input,
.calendar-trigger-item ion-textarea {
  --color: white;
  --placeholder-color: #8f9aaa;
}

ion-modal.dark-calendar-modal {
  --width: max-content;
  --height: max-content;
  --background: transparent;
  --box-shadow: none;
  --border-radius: 24px;

  align-items: center;
  justify-content: center;

  ion-datetime.custom-amber-calendar {
    --background: #151b23;
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);

    color: #ffffff;
    --ion-text-color: #ffffff;
    --ion-text-color-rgb: 255, 255, 255;

    --ion-color-primary: #f5a623;
    --ion-color-primary-rgb: 245, 166, 35;
    --ion-color-primary-contrast: #0b0f14;
    --ion-color-primary-contrast-rgb: 11, 15, 20;

    &::part(month-year-button) {
